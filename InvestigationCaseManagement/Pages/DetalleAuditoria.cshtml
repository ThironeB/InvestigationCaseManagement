@page "{id:int}"
@model InvestigationCaseManagement.Pages.DetalleAuditoriaModel
@{
    ViewData["Title"] = "Detalle de Auditoría";
}

<h2>Detalle de Auditoría</h2>

<div class="d-flex gap-3" style="padding-right: 3rem;">
    <div class="form-group col-md-3">
        <p><strong>Fecha:</strong> @Model.Auditoria.Fecha</p>
    </div>
    <div class="form-group col-md-3">
        <p><strong>Usuario:</strong> @Model.Auditoria.Usuario</p>
    </div>
    <div class="form-group col-md-3">
        <p><strong>Entidad:</strong> @Model.Auditoria.Entidad</p>
    </div>
    <div class="form-group col-md-3">
        <p><strong>Acción:</strong> @Model.Auditoria.Accion</p>
    </div>
</div>
<div class="d-flex gap-3" style="padding-right: 3rem;">
    <p><strong>Detalles:</strong> @Model.Auditoria.Detalle</p>
</div>


<h3>Datos Completos de la Entidad</h3>
<pre>@Model.DatosDeserializados</pre>

<a asp-page="ListaAuditorias" class="btn btn-secondary">Volver</a>
