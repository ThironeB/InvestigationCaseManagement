@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>GestiónIC</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/InvestigationCaseManagement.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-icons/1.8.1/font/bootstrap-icons.min.css" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-page="/Index">GestiónCI</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <!-- Si el usuario está autenticado, se muestran los tabs en el menu -->
                        @if (SignInManager.IsSignedIn(User))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" id="registro-tab" asp-area="" asp-page="/RegistroCasos">Registro de Casos</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" id="lista-casos-tab" asp-area="" asp-page="/ListaCasos">Lista de Casos</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" id="registrar-archivo-tab" asp-area="" asp-page="/RegistrarArchivo">Registrar Archivo</a>
                            </li>
                            // Si el usuario es administrador, se le muestran las opciones de gestionar archivo y reportes
                            @if (UserManager.IsInRoleAsync(UserManager.GetUserAsync(User).Result, "Administrador").Result) 
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark" id="gestionar-archivo-tab" asp-area="" asp-page="/ListaArchivos">Gestionar Archivo</a>
                                </li>
                            
                                <li class="nav-item">
                                    <a class="nav-link text-dark" id="reportes-tab" asp-area="" asp-page="/Reportes">Reportes</a>
                                </li>
                            }
                            <li class="nav-item">
                                <a class="nav-link text-dark" id="auditoria-tab" asp-area="" asp-page="/ListaAuditorias">Auditoria</a>
                            </li>
                        }
                    </ul>
                    <ul class="navbar-nav">
                        <partial name="_LoginPartial" /> <!-- Código del login y registro -->
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2025 - InvestigationCaseManagement - <a asp-area="" asp-page="/Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
